# Persistent multiplayer room database. Never use NEXT_PUBLIC_ for these.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional relay for networks that block peer-to-peer WebRTC.
# Cloudflare permanent key stays on the server; clients receive expiring credentials.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Alternatively configure another TURN provider here.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
